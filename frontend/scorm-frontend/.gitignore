# ------------------------------------------------
# Angular - Caché y Configuración Local
# ------------------------------------------------
# Carpeta de cache de Angular (Importante en v13+)
.angular/

# Archivos de entorno generados (Opcional, descomentar si usas SSR)
# /dist/server

# ------------------------------------------------
# IDEs y Editores
# ------------------------------------------------
# Visual Studio Code
.vscode/
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
# (Nota: Las líneas con '!' permiten subir configuraciones útiles para el equipo, 
# pero ignoran configuraciones personales)

# IntelliJ / WebStorm
.idea/
*.iws
*.iml
*.ipr

# Eclipse
.project
.classpath
.cproject
.settings/

